# ============================================================
# Learing Web - .gitattributes
# ============================================================
# Git checkout/commit line-ending handling and binary file declarations

# ---------- Default ----------
* text=auto

# ---------- Source code (normalize to LF) ----------
*.cs text eol=lf
*.aspx text eol=lf
*.aspx.cs text eol=lf
*.aspx.designer.cs text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.xml text eol=lf
*.config text eol=lf
*.csproj text eol=lf
*.sln text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
Dockerfile text eol=lf
docker-compose.yml text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# ---------- Binary (no transformation) ----------
*.png binary
*.jpg binary
*.jpeg binary
*.jfif binary
*.gif binary
*.ico binary
*.svg text
*.ttf binary
*.woff binary
*.woff2 binary
*.eot binary
*.otf binary
*.mp4 binary
*.avi binary
*.wmv binary

# ---------- Database ----------
*.sql text eol=lf

# ---------- Images (keep out of language stats) ----------
*.png linguist-vendored
*.jpg linguist-vendored
*.jpeg linguist-vendored
*.jfif linguist-vendored
font/* linguist-vendored
img/* linguist-vendored
file/* linguist-vendored

# ---------- Diff settings ----------
*.aspx diff=aspx
*.cs diff=csharp
*.js diff=javascript
*.css diff=css
*.config diff=xml
*.yml diff=yaml
