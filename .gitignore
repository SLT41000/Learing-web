# ============================================================
# Learing Web - .gitignore
# ============================================================
# Exclude generated, user-specific, and secret files from Git

### .NET build artifacts ###
# Build output
**/bin/
**/obj/
*.dll
*.pdb
*.exe
*.user
*.suo

# IDE
.vs/
.vscode/
*.idea/

# NuGet
packages/
packages.lock.json

# OS
.DS_Store
Thumbs.db

# IIS/ASP.NET
*.config.transform

# Code coverage
coverage/
*.coverage
*.coveragexml

# Test results
TestResults/

# Logs
*.log
*.txt

# Connection strings - NEVER commit!
Learing web/ConnectionStrings.config

# SQL dump files (if any)
*.sql

# Local environment files
.env
.env.local
