@page "{id:int}"
@model LearingWeb.Pages.CertificateModel
@{
    ViewData["Title"] = "Completed lessons — Learing Web";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/progress.css" asp-append-version="true" />
</head>
<body>
    <header class="progress-header">
        <nav class="progress-nav" aria-label="Main navigation">
            <a class="progress-brand" asp-page="/Index">Learing Web</a>
            <div class="progress-nav-links">
                <a asp-page="/Index">Explore lessons</a>
                <a asp-page="/Catalog" asp-route-id="@Model.Id">My learning</a>
                <a asp-page="/About">About</a>
            </div>
        </nav>
    </header>
    <main class="progress-main">
        <div class="progress-heading">
            <div>
                <p class="progress-eyebrow">A little progress adds up</p>
                <h1>Completed lessons</h1>
                <p>Your finished lessons and the moments you earned them.</p>
            </div>
            <a class="progress-button" asp-page="/Index">Find a lesson <span aria-hidden="true">&nbsp;→</span></a>
        </div>

        @if (Model.CompletedList.Count == 0)
        {
            <section class="progress-empty">
                <span class="progress-empty-icon" aria-hidden="true">✦</span>
                <h2>Your first completion is waiting</h2>
                <p>Finish a lesson and it will be celebrated here.</p>
                <a class="progress-button" asp-page="/Index">Browse lessons</a>
            </section>
        }
        else
        {
            <section class="certificate-grid" aria-label="Completed lessons">
                @foreach (var completed in Model.CompletedList)
                {
                    <article class="certificate-card">
                        <span class="certificate-seal" aria-hidden="true">✓</span>
                        <h2>@completed.Vname</h2>
                        <p>@completed.MidName · Completed @completed.Ontime</p>
                        <a asp-page="/Watch" asp-route-id="@completed.Vid">Review lesson →</a>
                    </article>
                }
            </section>
        }
    </main>
    <footer class="progress-footer">Every completed lesson is a step forward.</footer>
</body>
</html>
