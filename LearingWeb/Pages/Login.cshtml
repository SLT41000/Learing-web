<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Login - Learing Web</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.1/dist/css/bootstrap.min.css" />
    <link href="~/css/site.css" rel="stylesheet" />
    <style>
        body {
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            min-height: 100vh;
        }
        .login-card { max-width: 420px; margin: 80px auto; }
    </style>
</head>
<body class="text-white">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="/">Learing Web</a>
            <div class="collapse navbar-collapse">
                <ul class="navbar-nav ml-auto">
                    <li class="nav-item"><a class="nav-link" href="/">Back to Home</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 login-card">
                <div class="card shadow">
                    <div class="card-body p-4">
                        <h2 class="text-center mb-4" style="font-weight:700;">Welcome Back</h2>
                        <p class="text-center text-muted mb-4">Sign in to continue learning</p>

                        <form method="post">
                            <div class="form-group mb-3">
                                <input type="text" id="username" name="username" placeholder="Username"
                                       class="form-control" required autofocus />
                            </div>
                            <div class="form-group mb-3">
                                <input type="password" id="password" name="password" placeholder="Password"
                                       class="form-control" required />
                            </div>
                            <div class="d-grid">
                                <button type="submit" class="btn btn-primary btn-block">Sign In</button>
                            </div>
                        </form>

                        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                        {
                            <div class="alert alert-danger mt-3 text-center">@Model.ErrorMessage</div>
                        }

                        <div class="text-center mt-3">
                            <span class="text-muted">Don't have an account? </span>
                            <a href="/signin" class="text-info" style="font-weight:600;">Sign Up</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.1/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
