@page "{id}"
@model LearingWeb.Pages.WatchModel
@{
    ViewData["Title"] = "Watch — Son Heung-min Learning";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <div class="container" style="max-width: 900px;">
        <div class="d-flex align-items-center mb-3">
            <a asp-page="/Index" class="btn btn-outline-secondary">← Back</a>
            <span class="ms-auto text-muted small">@Model.UserName</span>
        </div>
        @if (!string.IsNullOrEmpty(Model.Video.Vid))
        {
            <div class="card mb-3" style="border-left: 6px solid #1b2a6b; border-radius: 8px;">
                <div class="card-body">
                    <h4 class="card-title">@Model.Video.Vname</h4>
                    <p class="text-muted small mb-2">@Model.Video.MidName</p>
                    <p class="card-text">@Model.Video.Vdesc</p>
                    @if (!string.IsNullOrWhiteSpace(Model.Video.Vlink))
                    {
                        <div class="ratio ratio-16x9 mt-2 mb-2">
                            <iframe src="@Model.Video.Vlink" title="@Model.Video.Vname"
                                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                    allowfullscreen></iframe>
                        </div>
                        <a href="@Model.Video.Vlink" target="_blank" rel="noopener noreferrer">Having trouble? Open the video in a new tab.</a>
                    }
                    else
                    {
                        <div class="alert alert-info">A video link has not been added for this lesson yet.</div>
                    }
                    <div class="d-flex gap-2 mt-2">
                        @if (!string.IsNullOrEmpty(Model.WatchCheck.Ontime))
                        {
                            <div class="alert alert-success py-2">
                                You checked in at @Model.WatchCheck.Ontime.
                            </div>
                        }
                    </div>
                    <div class="mt-2">
                        @{
                            var already = Model.WatchCheck.Alreadywatch == "1";
                        }
                        @if (Model.Aid > 0)
                        {
                            <form method="post" asp-page-handler="Checkin" asp-route-id="@Model.Video.Vid" class="d-inline">
                                <button class="btn btn-primary" type="submit">Check in</button>
                            </form>
                            @if (!already)
                            {
                                <form method="post" asp-page-handler="MarkWatched" asp-route-id="@Model.Video.Vid" class="d-inline ms-2">
                                    <button class="btn btn-success" type="submit">Mark as watched</button>
                                </form>
                            }
                            else
                            {
                                <span class="badge bg-success py-2">Completed</span>
                            }
                        }
                        else
                        {
                            <a asp-page="/Login" class="btn btn-outline-primary">Log in to track progress</a>
                        }
                    </div>
                </div>
            </div>
            @if (Model.Aid > 0)
            {
                <a asp-page="/Catalog" asp-route-id="@Model.Aid" class="btn btn-outline-primary">View My Catalog</a>
                <a asp-page="/Certificate" asp-route-id="@Model.Aid" class="btn btn-outline-warning ms-2">Completed lessons</a>
            }
        }
        else
        {
            <div class="alert alert-warning">Video not found.</div>
            <a asp-page="/Index" class="btn btn-primary">Go Home</a>
        }
    </div>
</body>
</html>
