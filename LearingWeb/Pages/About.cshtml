@page
@model LearingWeb.Pages.AboutModel
@{
    ViewData["Title"] = "About - Learing Web";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.1/dist/css/bootstrap.min.css" />
    <link href="~/css/site.css" rel="stylesheet" />
</head>
<body class="bg-secondary text-white">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="/">Learing Web</a>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ml-auto">
                    <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="/login">Login</a></li>
                    <li class="nav-item"><a class="nav-link" href="/signin">Sign in</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <section class="wrapper">
        <div class="container-fostrap">
            <div class="content">
                <div class="container">
                    <div class="main-card">
                        <div class="text-center py-5">
                            <h1 class="display-4 font-weight-bold" style="color:#ffc107;">About Learing Web</h1>
                            <hr class="my-4" />
                            <p class="lead text-muted">
                                Learing Web is a learning management platform built with ASP.NET Core 8.
                                It helps students discover courses, track their progress, and earn certificates.
                            </p>
                            <p class="text-muted mt-3">
                                Built for cross-platform deployment — runs on Linux, Windows, and Docker containers.
                            </p>
                            <hr class="my-4" />
                            <div class="row text-center">
                                <div class="col-md-4">
                                    <h5 class="text-light">📚 Course Library</h5>
                                    <p class="text-muted">Browse physics, chemistry, biology, calculus, statistics, and applied mathematics.</p>
                                </div>
                                <div class="col-md-4">
                                    <h5 class="text-light">🎓 Certificates</h5>
                                    <p class="text-muted">Earn certificates when you complete video courses.</p>
                                </div>
                                <div class="col-md-4">
                                    <h5 class="text-light">📊 Progress Tracking</h5>
                                    <p class="text-muted">Track your watch history and completed courses.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.1/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
