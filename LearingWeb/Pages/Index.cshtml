@page
@model LearingWeb.Pages.IndexModel
@{
    var userName = HttpContext.Session.GetString("uname");
    var accountId = HttpContext.Session.GetInt32("aid");
    ViewData["Title"] = "Learing Web — Learn through the game";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f5f7fb" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="navigation page-width" aria-label="Main navigation">
            <a class="wordmark" asp-page="/Index" aria-label="Learing Web home">
                <span class="wordmark-icon" aria-hidden="true">L</span>
                <span>Learing<span class="wordmark-light">Web</span></span>
            </a>
            <div class="nav-links">
                <a class="nav-link nav-link-current" asp-page="/Index">Learn</a>
                <a class="nav-link" asp-page="/About">About</a>
                @if (accountId is not null)
                {
                    <a class="nav-link" asp-page="/Catalog" asp-route-id="@accountId">My learning</a>
                    <a class="nav-link" asp-page="/Certificate" asp-route-id="@accountId">Certificates</a>
                }
            </div>
            <div class="nav-account">
                @if (string.IsNullOrWhiteSpace(userName))
                {
                    <a class="sign-in-link" asp-page="/Login">Log in</a>
                    <a class="button button-small" asp-page="/Signin">Create account</a>
                }
                else
                {
                    <span class="welcome-message">Hi, @userName</span>
                    <form method="post" asp-page="/Logout">
                        <button class="button button-small button-quiet" type="submit">Log out</button>
                    </form>
                }
            </div>
        </nav>
    </header>

    <main>
        <section class="hero page-width" aria-labelledby="hero-title">
            <div class="hero-copy">
                <p class="eyebrow"><span class="eyebrow-dot" aria-hidden="true"></span> A better way to learn English</p>
                <h1 id="hero-title">Learn from the moments <span>that move you.</span></h1>
                <p class="hero-description">
                    Build your English through the real stories, interviews, and career of football star Son Heung-min.
                    Watch a short lesson, pick up a phrase, and keep your progress.
                </p>
                <div class="hero-actions">
                    <a class="button" href="#courses">Explore lessons <span aria-hidden="true">↓</span></a>
                    @if (accountId is null)
                    {
                        <a class="text-action" asp-page="/Signin">Create a free account <span aria-hidden="true">→</span></a>
                    }
                </div>
                <div class="hero-note">
                    <span class="avatar-stack" aria-hidden="true"><span>S</span><span>E</span><span>✓</span></span>
                    <span>Watch at your pace. Progress is yours to keep.</span>
                </div>
            </div>
            <div class="hero-art" aria-hidden="true">
                <div class="art-glow"></div>
                <div class="art-ball">01</div>
                <div class="art-line art-line-one"></div>
                <div class="art-line art-line-two"></div>
                <div class="art-label"><span>LEARN</span><span>·</span><span>PLAY</span><span>·</span><span>GROW</span></div>
                <div class="art-caption"><span class="caption-dot"></span> Your next lesson starts here</div>
            </div>
        </section>

        <section class="course-section page-width" id="courses" aria-labelledby="courses-title">
            <div class="section-heading">
                <div>
                    <p class="eyebrow">The course library</p>
                    <h2 id="courses-title">Choose your next lesson</h2>
                    <p class="section-description">Explore a chapter of Son's journey or jump into a topic you love.</p>
                </div>
                @if (Model.ActiveSubjectId is not null)
                {
                    <a class="clear-filter" asp-page="/Index">Show all lessons <span aria-hidden="true">×</span></a>
                }
            </div>

            <div class="subject-filters" aria-label="Filter lessons by topic">
                <a class="filter-chip @(Model.ActiveSubjectId is null ? "filter-active" : "")"
                   asp-page="/Index" aria-current="@(Model.ActiveSubjectId is null ? "true" : null)">All lessons</a>
                @foreach (var subject in Model.Subjects)
                {
                    <a class="filter-chip @(Model.ActiveSubjectId == subject.Key ? "filter-active" : "")"
                       asp-page="/Index" asp-route-subject="@subject.Key"
                       aria-current="@(Model.ActiveSubjectId == subject.Key ? "true" : null)">
                        @subject.Value.Cname
                    </a>
                }
            </div>

            <div class="catalog-toolbar">
                <label class="search-box" for="courseSearch">
                    <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false"><circle cx="11" cy="11" r="7"></circle><path d="m16 16 4 4"></path></svg>
                    <input id="courseSearch" type="search" placeholder="Search lessons..." aria-label="Search lessons" autocomplete="off" />
                </label>
                <p class="results-count" id="resultsCount" aria-live="polite">@Model.Videos.Count lesson@(Model.Videos.Count == 1 ? "" : "s")</p>
            </div>

            @if (Model.Videos.Count == 0)
            {
                <div class="empty-state">
                    <span class="empty-icon" aria-hidden="true">✦</span>
                    <h3>No lessons in this topic yet</h3>
                    <p>Try another topic or view the full lesson library.</p>
                    <a class="button button-small" asp-page="/Index">Show all lessons</a>
                </div>
            }
            else
            {
                <div class="course-grid" id="courseGrid">
                    @foreach (var video in Model.Videos)
                    {
                        var subject = Model.Subjects.Values.FirstOrDefault(item => item.Cid == video.Mid);
                        var subjectName = subject?.Cname ?? "Featured lesson";
                        <article class="course-card" data-search="@($"{video.Vname} {video.Vdesc} {subjectName}")">
                            <div class="course-art course-art-@video.Mid">
                                <span class="course-art-mark" aria-hidden="true">@(video.Mid == "1" ? "01" : video.Mid.PadLeft(2, '0'))</span>
                                <span class="course-art-label">LEARNING SERIES</span>
                                <span class="play-mark" aria-hidden="true">▶</span>
                            </div>
                            <div class="course-content">
                                <span class="course-topic">@subjectName</span>
                                <h3>@video.Vname</h3>
                                <p>@(string.IsNullOrWhiteSpace(video.Vdesc) ? "Watch the story, learn a phrase, and practice your English." : video.Vdesc)</p>
                                <div class="course-footer">
                                    <span class="lesson-type"><span aria-hidden="true">◷</span> Video lesson</span>
                                    <a class="watch-link" asp-page="/Watch" asp-route-id="@video.Vid"
                                       aria-label="Watch lesson: @video.Vname">Watch <span aria-hidden="true">→</span></a>
                                </div>
                            </div>
                        </article>
                    }
                </div>
                <div class="empty-state search-empty" id="searchEmpty" hidden>
                    <span class="empty-icon" aria-hidden="true">⌕</span>
                    <h3>No matching lessons</h3>
                    <p>Try a different title or topic.</p>
                </div>
            }
        </section>
    </main>

    <footer class="site-footer">
        <div class="page-width footer-content">
            <a class="wordmark footer-wordmark" asp-page="/Index">
                <span class="wordmark-icon" aria-hidden="true">L</span>
                <span>Learing<span class="wordmark-light">Web</span></span>
            </a>
            <p>Learn a little. Grow a lot. © @DateTime.Now.Year Learing Web</p>
        </div>
    </footer>

    <script>
        const searchInput = document.getElementById("courseSearch");
        const courseCards = Array.from(document.querySelectorAll(".course-card"));
        const searchEmpty = document.getElementById("searchEmpty");
        const resultsCount = document.getElementById("resultsCount");

        searchInput?.addEventListener("input", () => {
            const query = searchInput.value.trim().toLocaleLowerCase();
            let visibleCount = 0;

            for (const card of courseCards) {
                const matches = card.dataset.search.toLocaleLowerCase().includes(query);
                card.hidden = !matches;
                if (matches) visibleCount++;
            }

            if (searchEmpty) searchEmpty.hidden = visibleCount !== 0;
            if (resultsCount) {
                resultsCount.textContent = `${visibleCount} lesson${visibleCount === 1 ? "" : "s"}`;
            }
        });
    </script>
</body>
</html>
