<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sign Up - Learing Web</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.1/dist/css/bootstrap.min.css" />
    <link href="~/css/site.css" rel="stylesheet" />
    <style>
        body {
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            min-height: 100vh;
        }
        .signup-card { max-width: 520px; margin: 60px auto; }
        .subject-checkboxes label {
            display: inline-block;
            margin-right: 12px;
            margin-bottom: 6px;
            padding: 8px 16px;
            background: rgba(255,255,255,0.1);
            border-radius: 8px;
            cursor: pointer;
            transition: background 0.2s;
        }
        .subject-checkboxes label:hover { background: rgba(255,255,255,0.2); }
        .subject-checkboxes input[type="checkbox"] { accent-color: #56baed; }
    </style>
</head>
<body class="text-white">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="/">Learing Web</a>
            <div class="collapse navbar-collapse">
                <ul class="navbar-nav ml-auto">
                    <li class="nav-item"><a class="nav-link" href="/">Back to Home</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 signup-card">
                <div class="card shadow">
                    <div class="card-body p-4">
                        <h2 class="text-center mb-4" style="font-weight:700;">Create Your Account</h2>
                        <p class="text-center text-muted mb-4">Join Learing Web and start your learning journey</p>

                        <form method="post">
                            <div class="form-group mb-3">
                                <label class="text-info">Username</label>
                                <input type="text" id="username" name="username" placeholder="Choose a username"
                                       class="form-control" required />
                            </div>
                            <div class="form-group mb-3">
                                <label class="text-info">Password</label>
                                <input type="password" id="password" name="password" placeholder="Choose a password"
                                       class="form-control" required />
                            </div>

                            <div class="form-group mb-3">
                                <label class="text-info">Select Subjects You Want to Learn</label>
                                <div class="subject-checkboxes">
                                    <label><input type="checkbox" name="mid" value="1" /> Physics</label>
                                    <label><input type="checkbox" name="mid" value="2" /> Chemical</label>
                                    <label><input type="checkbox" name="mid" value="3" /> Biology</label>
                                    <label><input type="checkbox" name="mid" value="4" /> Calculus</label>
                                    <label><input type="checkbox" name="mid" value="5" /> Statistics</label>
                                    <label><input type="checkbox" name="mid" value="6" /> Applied Mathematics</label>
                                </div>
                            </div>

                            <div class="d-grid">
                                <button type="submit" class="btn btn-primary btn-block">Create Account</button>
                            </div>
                        </form>

                        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
                        {
                            <div class="alert alert-success mt-3 text-center">@Model.SuccessMessage</div>
                        }
                        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                        {
                            <div class="alert alert-danger mt-3 text-center">@Model.ErrorMessage</div>
                        }

                        <div class="text-center mt-3">
                            <span class="text-muted">Already have an account? </span>
                            <a href="/login" class="text-info" style="font-weight:600;">Sign In</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.1/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
