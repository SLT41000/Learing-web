@page
@model LearingWeb.Pages.SigninModel
@{
    ViewData["Title"] = "Create an account — Learing Web";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/auth-modern.css" asp-append-version="true" />
</head>
<body>
    <main class="auth-shell">
        <div class="auth-wrap">
            <a class="auth-brand" asp-page="/Index">
                <span class="auth-brand-icon" aria-hidden="true">L</span>
                <span>Learing Web</span>
            </a>
            <section class="auth-card" aria-labelledby="signup-title">
                <p class="auth-eyebrow">Start your learning journey</p>
                <h1 id="signup-title">Create your account</h1>
                <p class="auth-intro">Choose a few topics and we'll help you find your next lesson.</p>

                @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                {
                    <div class="auth-error" role="alert">@Model.ErrorMessage</div>
                }

                <form method="post" asp-page="/Signin" class="auth-form">
                    <div class="field">
                        <label asp-for="Username">Username</label>
                        <input asp-for="Username" autocomplete="username" placeholder="Choose a username" minlength="3" maxlength="50" required />
                    </div>
                    <div class="field">
                        <label asp-for="Password">Password</label>
                        <input asp-for="Password" type="password" autocomplete="new-password" placeholder="At least 6 characters" minlength="6" required />
                    </div>
                    <div class="field">
                        <label asp-for="PasswordConfirm">Confirm password</label>
                        <input asp-for="PasswordConfirm" type="password" autocomplete="new-password" placeholder="Enter your password again" required />
                    </div>

                    @if (Model.Subjects.Count > 0)
                    {
                        <fieldset class="subject-picker">
                            <legend class="subject-label">Choose topics <span class="field-hint">(optional)</span></legend>
                            <div class="subject-options">
                                @foreach (var subject in Model.Subjects)
                                {
                                    var selected = HttpContext.Request.Method == "POST"
                                        && Request.Form["subject"].Contains(subject.Cid);
                                    <label class="subject-option">
                                        <input type="checkbox" name="subject" value="@subject.Cid" checked="@(selected ? "checked" : null)" />
                                        <span>@subject.Cname</span>
                                    </label>
                                }
                            </div>
                        </fieldset>
                    }

                    <button class="auth-submit" type="submit">Create account</button>
                </form>

                <p class="auth-bottom">Already have an account? <a asp-page="/Login">Log in</a></p>
            </section>
            <a class="auth-back" asp-page="/Index">← Back to the lesson library</a>
        </div>
    </main>
</body>
</html>
